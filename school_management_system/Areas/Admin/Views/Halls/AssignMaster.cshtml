@{
    var hall = (Hall)ViewData["Hall"]!; ViewData["Title"] = "Hall master";
}
<div class="page-head"><div><h1>Hall master for @hall.Name</h1><p>Choose a teacher. They keep one login and gain access to the Hall Master portal.</p></div></div>
<div class="card" style="max-width:640px">
    <div class="card-body">
        <form method="post" class="form" asp-action="AssignMaster" asp-route-id="@hall.Id">
            <div class="field">
                <label>Teacher</label>
                <select name="teacherId" asp-items="(SelectList)ViewBag.Teachers" required>
                    <option value="">Select a teacher…</option>
                    </select>
              </div>
            <div class="form-actions">
                <button class="btn primary">Assign</button>
                <a class="btn" asp-action="Details" asp-route-id="@hall.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
