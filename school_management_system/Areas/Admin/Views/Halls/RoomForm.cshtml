@using school_management_system.Models.Domain
@model RoomVm
@{
    ViewData["Title"] = "Edit room";
}
<div class="page-head"><div><h1>Edit room</h1></div></div>
<div class="card">
    <div class="card-body">
        <form method="post" class="form" asp-action="EditRoom">
            <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="HallId" />
            <div class="row2">
                <div class="field"><label asp-for="Number"></label><input asp-for="Number" /><span asp-validation-for="Number"></span></div>
                <div class="field"><label asp-for="Capacity">Beds</label><input asp-for="Capacity" type="number" min="1" /><span asp-validation-for="Capacity"></span></div>
            </div>
            <div class="form-actions"><button class="btn primary">Save</button><a class="btn" asp-action="Details" asp-route-id="@Model.HallId">Cancel</a></div>
        </form>
    </div>
</div>
