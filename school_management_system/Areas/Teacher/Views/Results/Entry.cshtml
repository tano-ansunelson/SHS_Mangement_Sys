@using school_management_system.Models.Domain
@using school_management_system.Models.Enums
@model EntryVm
@{
    var note = ViewData["ReturnNote"] as string;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var isFinal = Model.Type == AssessmentType.Final;
}
<div class="page-head">
    <div>
        <h1>@Model.SubjectName</h1>
        <p>@Model.ClassName · @Model.AssessmentTitle</p>
    </div>
    <div class="actions">
        <a class="btn" asp-action="Index" asp-route-assessmentId="@Model.AssessmentId">Back</a>
    </div>
</div>
@if (!string.IsNullOrEmpty(note))
{
    <div class="alert error">
        <b>Returned by the coordinator:</b> @note
    </div>
}
@if (Model.Locked)
{
    <div class="alert info">These scores are submitted (or the examination is closed), so they can no longer be edited.</div>
}
<form method="post" asp-action="Save">
    <input type="hidden" asp-for="ClassYearId" /><input type="hidden" asp-for="SubjectId" /><input type="hidden" asp-for="AssessmentId" />
    <div class="card">
        <div class="card-head">
            <h2>@Model.ScoreLabel</h2>
            <span class="muted small">@(isFinal ? "Out of " + Model.Max.ToString("0.#") + " · the semester total is the midterm score (out of " + Model.MidtermMax.ToString("0.#") + ") plus this score" : "Out of " + Model.Max.ToString("0.#") + " · you will enter the final exam score when the admin creates the final exam")</span>
        </div>
        <div class="card-body flush table-wrap">
            @if (!Model.Rows.Any())
            {
                <div class="empty">No students in this class yet.</div>
            }
            else
            {
                <table class="data">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Student</th>@if (isFinal)
                            {
                                <th class="num">Midterm score</th>
                            }
                            <th>@Model.ScoreLabel</th>@if (isFinal) {
                            <th class="num">Semester total</th>
                        }
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        var r = Model.Rows[i];
                        <tr data-mid="@(r.Midterm?.ToString("0.##", inv))">
                            <td class="muted">@(i + 1)</td>
                            <td>
                                <b>@r.Name</b>
                                <div class="muted small">@r.Number</div>
                                <input type="hidden" name="Rows[@i].EnrollmentId" value="@r.EnrollmentId" />
                            </td>
                            @if (isFinal)
                            {
                                <td class="num">@(r.Midterm?.ToString("0.#") ?? "—")</td>
                            }
                            <td>
                                <input class="sc" type="number" step="0.5" min="0" max="@Model.Max.ToString(inv)" name="Rows[@i].Score" value="@(r.Score?.ToString("0.##", inv))" disabled="@Model.Locked" />
                            </td>
                            @if (isFinal)
                            {
                                <td class="num">
                                    <b class="tot">—</b>
                                </td>
                            }
                            <td>
                                @if (r.Status != null)
                                {
                                    <span class="badge @Ui.Status(r.Status.Value)">@r.Status</span>
                                }
                                else
                                {

                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
@if (!Model.Locked && Model.Rows.Any())
{
    <div class="actions"><button class="btn primary">Save scores</button></div>
}
</form>
@if (!Model.Locked && Model.Rows.Any())
{
    <form method="post" asp-action="Submit" class="inline" data-confirm="Submit these results to the class coordinator? You cannot edit them afterwards unless they are returned." style="display:block;margin-top:12px">
        <input type="hidden" name="classYearId" value="@Model.ClassYearId" /><input type="hidden" name="subjectId" value="@Model.SubjectId" /><input type="hidden" name="assessmentId" value="@Model.AssessmentId" />
        <button class="btn">Submit to coordinator</button> <span class="muted small">Save first. Every student needs a score before you can submit.</span>
    </form>
}
@section Scripts {
    @if (isFinal)
    {
        <script>
            document.querySelectorAll('tbody tr').forEach(tr => {
                const sc = tr.querySelector('.sc'), t = tr.querySelector('.tot'), mid = parseFloat(tr.dataset.mid);
                if (!sc || !t) return;
                const calc = () => { const v = parseFloat(sc.value); t.textContent = (isNaN(v) || isNaN(mid)) ? '—' : (v + mid).toFixed(1).replace(/\.0$/, ''); };
                sc.addEventListener('input', calc); calc();
            });
        </script>
    }
}
