@using school_management_system.Models.Domain
@model ConfirmDeleteVm
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-head"><div><h1>@Model.Title</h1></div></div>
<div class="card" style="max-width:640px">
    <div class="card-body">
        <p>@Model.Message</p>
        <form method="post" action="@Model.Action" class="form-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn danger">@Model.Button</button>
            <a class="btn" href="@Model.Back">Cancel</a>
        </form>
    </div>
</div>
