@using school_management_system.Service
@model AccountCredentials
@{
    ViewData["Title"] = "Account credentials";
}
<div class="page-head">
    <div><h1>Account ready</h1><p>Give these details to <b>@Model.FullName</b>. The password is shown only once.</p></div>
    <div class="actions"><button class="btn" onclick="window.print()">Print</button></div>
</div>
<div class="credbox" style="max-width:640px">
    <dl class="kv">
        <dt>ID number</dt>
        <dd><code>@Model.Number</code></dd>
        <dt>Email (login)</dt>
        <dd><code>@Model.Email</code></dd>
        <dt>Temporary password</dt>
        <dd><code>@Model.Password</code></dd>
    </dl>
    <p class="muted small" style="margin-bottom:0">They will be asked to choose a new password the first time they sign in.</p>
</div>
<p><a class="btn" href="@(ViewData["Back"] ?? "/")">Done</a></p>
