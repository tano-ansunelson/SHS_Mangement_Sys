@using school_management_system.Models.Domain
@model ChangePasswordVm
@{
    ViewData["Title"] = "Change password";
}
<div class="page-head">
    <div>
        <h1>Change password</h1>
        @if (ViewData["Forced"] is true)
        {
            <p>Choose a new password before you continue.</p>
        }
    </div>
</div>
<div class="card" style="max-width:560px">
    <div class="card-body">
        <form method="post" class="form">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="field"><label asp-for="Current"></label><input asp-for="Current" /><span asp-validation-for="Current"></span></div>
            <div class="field">
                <label asp-for="New"></label><input asp-for="New" /><span asp-validation-for="New"></span>
                <div class="hint">At least 8 characters with upper and lower case letters, a number and a symbol.</div>
            </div>
            <div class="field"><label asp-for="Confirm"></label><input asp-for="Confirm" /><span asp-validation-for="Confirm"></span></div>
            <div class="form-actions"><button class="btn primary">Update password</button></div>
        </form>
    </div>
</div>
